{
  "name": "ai-desk-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.server.json",
    "start": "node dist/server/server/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "hash-password": "tsx scripts/hash-password.ts",
    "gen-secret": "node -e \"console.log(require('crypto').randomBytes(32).toString('base64'))\"",
    "set-password": "tsx scripts/hash-password.ts --write-env"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.12.0",
    "@fastify/cookie": "11.1.5",
    "@fastify/static": "10.1.12",
    "@node-rs/argon2": "2.2.2",
    "better-sqlite3": "13.2.0",
    "fastify": "5.12.8",
    "google-auth-library": "11.3.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.6",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@testing-library/react": "16.3.3",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "concurrently": "10.0.7",
    "jsdom": "31.0.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
