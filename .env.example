# Copy to .env (never commit .env). Docker compose reads it via env_file.
# Values containing `$` (OWNER_PASSWORD_HASH) must be wrapped in single quotes.

# --- Server ---
# Public origin of the app (must match the URL in the browser; https:// enables Secure cookies).
APP_ORIGIN=https://desk.example.com
# Domain Caddy requests a certificate for (deploy/docker-compose.yml only).
DOMAIN=desk.example.com
# Listen port inside the container/process.
PORT=3000
# Listen address (0.0.0.0 in the container; compose publishes it on 127.0.0.1 only).
HOST=0.0.0.0
# SQLite file path (the container uses /data/dashboard.db on the desk-data volume).
DATABASE_PATH=/data/dashboard.db
# production fails fast if secrets below are missing.
NODE_ENV=production
# true = synthetic data only, no providers contacted. Keep false in real use.
DEMO_MODE=false
# Fastify/pino log level: fatal|error|warn|info|debug|trace.
LOG_LEVEL=info
# true when behind a reverse proxy (Caddy) so the client IP comes from X-Forwarded-For.
TRUST_PROXY=true

# --- Secrets (required in production) ---
# Cookie/session signing secret. Generate with: npm run gen-secret
SESSION_SECRET=replace-me
# base64 of exactly 32 bytes; encrypts stored provider tokens. Generate with: npm run gen-secret
# Back this up SEPARATELY from DB backups; without it stored tokens are unrecoverable.
TOKEN_ENCRYPTION_KEY=replace-me
# argon2id hash of the owner password. Easiest: npm run set-password (writes it into .env for you); or npm run hash-password to print it.
# Single-quote it, the hash contains `$` characters.
OWNER_PASSWORD_HASH='$argon2id$v=19$m=19456,t=2,p=1$replace$me'

# --- Providers ---
# LTA DataMall AccountKey (bus arrivals).
LTA_ACCOUNT_KEY=
# data.gov.sg API key (optional; raises weather API rate limits).
DATA_GOV_SG_API_KEY=
# Canvas instance base URL, e.g. https://school.instructure.com
CANVAS_BASE_URL=
# Canvas personal access token (read-only use).
CANVAS_ACCESS_TOKEN=
# Google OAuth client (Calendar read-only).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match the redirect URI registered in Google Cloud, e.g. https://desk.example.com/api/google/callback
GOOGLE_REDIRECT_URI=
# Live Garmin fetching is implemented (Personal API key -> 24 h access token; read-only).
GARMIN_PERSONAL_API_KEY=

# --- AI briefing (optional) ---
# Only "anthropic" is supported.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Model used for briefings.
LLM_MODEL=claude-opus-5-5
# Maximum AI briefing requests per day.
AI_DAILY_REQUEST_CAP=10
